#!/bin/sh
# spire — the Zsharpend edition. Runs src/ through Whetstone.
# Resolve symlinks first so the runtime project path is based on the real launcher.
script_path="$0"
while [ -L "$script_path" ]; do
    link="$(readlink "$script_path")" || exit 1
    case "$link" in
        /*) script_path="$link" ;;
        *) script_path="$(dirname "$script_path")/$link" ;;
    esac
done
here="$(cd "$(dirname "$script_path")" && pwd)"
ws="${WHETSTONE:-}"
[ -n "$ws" ] || ws="$(command -v whetstone 2>/dev/null)"
if [ -z "$ws" ]; then
    for c in "$here/../z-nd/target/release/whetstone" "$here/../z-nd/target/debug/whetstone"; do
        [ -x "$c" ] && ws="$c" && break
    done
fi
if [ -n "$ws" ] && [ "${ws#/*}" = "$ws" ]; then
    ws="$here/$ws"
fi
if [ -z "$ws" ]; then
    echo "spire: Whetstone not found. Build it from https://github.com/trail-b1az3r/z-nd:" >&2
    echo "       cargo install --path crates/whetstone   (or set WHETSTONE=/path/to/whetstone)" >&2
    exit 127
fi
exec "$ws" run "$here" -- "$@"
