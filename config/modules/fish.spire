# fish.spire - fish-compatible helpers. Enable with `modules = ..., fish`.

# fish_add_path DIR...: prepend directories to $PATH (once)
function fish_add_path -d "add directories to PATH"
  for d in $argv
    if test -d "$d"
      if not string match -q "*:$d:*" ":$PATH:"
        export PATH="$d:$PATH"
      end
    end
  end
end

# funcsave-free `funced`-ish helper: list a function's description
function describe -a name -d "show what a command is"
  type $name
end

# fish's `vared` lite: edit a variable's value interactively
function vared -a name -d "edit a variable"
  read -p "$name: " value
  set $name $value
end
