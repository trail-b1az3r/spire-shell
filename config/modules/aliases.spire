# aliases.spire - a small starter set of quality-of-life aliases.
# Enable it by adding "aliases" to the `modules = ...` line in
# ~/.config/spire/spire.conf, or run `module load aliases` at any time.

# colors for the usual suspects (ls, ll and la are built in, fish-style)
alias l='ls -CF'
alias grep='grep --color=auto'
alias egrep='grep -E --color=auto'
alias fgrep='grep -F --color=auto'
alias diff='diff --color=auto'
alias ip='ip -color=auto'
export CLICOLOR=1

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias md='mkdir -p'

# fish-style abbreviations expand in place when you press space
abbr -a gs git status
abbr -a gd git diff
abbr -a gc git commit
abbr -a gco git checkout
abbr -a gp git push
abbr -a gl git log --oneline --graph --decorate
