# git.spire - a few small git helpers. The prompt can already show the
# current branch via %g (or %G with a dirty marker) in your `prompt` format
# string; this module adds interactive helpers on top of that.

function gbranch -d "print the current branch"
  git rev-parse --abbrev-ref HEAD
end

function gclean -d "is the working tree clean?"
  if test -n "$(git status --porcelain)"
    echo "working tree is dirty"
  else
    echo "working tree is clean"
  end
end

function gundo -d "undo the last commit, keeping its changes staged"
  git reset --soft HEAD~1
end

function groot -d "cd to the top of the repository"
  cd (git rev-parse --show-toplevel)
end

complete -c gbranch -f
complete -c gundo -f
