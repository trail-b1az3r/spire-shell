# parameter expansion, arrays, fish lists, quoting, arithmetic
f=/usr/local/lib/archive.tar.gz
echo ${f#*/} ${f##*/} ${f%.*} ${f%%.*}
echo ${f/lib/LIB} ${f//a/A} ${f/%gz/xz}
s=HelloWorld; echo ${s:5} ${s:0:5} ${s: -3} ${s^^} ${s,,} ${s,}
echo ${unset:-default} ${s:+alt} "${nothing:=assigned}" $nothing
echo ${x:-${s:-z}}
name=s; echo ${!name}
arr=(one two three four); echo ${arr[1]} ${#arr[@]} "${arr[@]:1:2}" ${arr[@]^}
echo ${!arr[@]}
echo $arr[2] $arr[-1] $arr[2..3]
echo "quoted: $arr"
for w in $arr; do echo "w=$w"; done
g() { for a in "$@"; do echo "[$a]"; done; echo "star=[$*]"; echo ${@:2}; }
g "a b" c d
echo $'tab\there' $'\x41\101'
echo $(( 2 + 3 * 4 )) $(( $(echo 5) * 2 ))
x=0; (( 0 && x++ )); (( 1 || x++ )); echo short-circuit $x
echo $((a=1, a+2))
echo ${#s} ${s@Q}
[ -n "$RANDOM" ] && echo random-ok
echo ~ | grep -q / && echo tilde-ok
