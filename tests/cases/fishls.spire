# fish-style ls/ll/la: functions exist, plain output when piped
type -t ls ll la
d=/tmp/spire-ls-$$; mkdir -p $d/sub; touch $d/f.txt
ls $d | cat
ll $d | grep -c '^d'
la $d | grep -c 'f.txt'
command -q ls && echo command-q-ok
command -s sh | grep -q / && echo command-s-ok
isatty stdout || echo stdout-not-tty
rm -rf $d
