# bash and fish builtins
printf "%-6s|%5.2f|%03d|%x|%q\n" name 3.14159 7 255 "a b"
printf "%s-" a b c; echo
printf -v out "%05d" 42; echo $out
echo -e "a\tb\x41|" | cat -A
eval 'echo eval $((1+1))'
type -t cd; type -t if; command -v sh >/dev/null && echo command-v-ok
declare -a list=(p q r); echo ${list[2]}
h() { local a=1 b=(x y); echo "$a ${b[1]}"; }; h; echo "a=[$a]"
string upper hello; string length "héllo"; string split , "a,b,c"; string join - x y z
string replace -a o 0 "foo boo"; string replace -r '([a-z]+)@([a-z]+)' '$2 at $1' "me@host"
string match -r '[0-9]+' "abc123def"; string sub -s 2 -l 3 abcdef
echo "a b c" | string split " "
math 1+2*3; math 10/4; math "2^10"; math -s2 1/3
count a b c; contains b a b c && echo has-b
OPTIND=1; while getopts "ab:c" o -a -b val -c; do echo "opt $o ${OPTARG:-}"; done
test -f /etc/passwd -a ! -d /etc/passwd && echo test-ok
[ \( 1 -eq 1 \) -o 2 -eq 3 ] && echo paren-ok
read -a parts <<< "p1 p2 p3"; echo ${parts[1]} ${#parts[@]}
IFS=: read u x rest <<< "root:x:0:0"; echo "$u|$rest"
set -o pipefail; false | true; echo pipefail=$?; set +o pipefail
true | false | true; echo ${PIPESTATUS[@]} $pipestatus
x=$(set -e; false; echo not-reached); echo "errexit=[$x]"
sleep 0.1 & wait $!; echo waited=$?
abbr -a gco git checkout; abbr
set -l fishlist a b c; echo $fishlist[2] (count $fishlist)
set -q fishlist && echo set-q-ok
trap 'echo trapped EXIT' EXIT
echo end
