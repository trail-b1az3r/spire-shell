# fish config constructs that must run unchanged
set -gx EDITOR vim
set -gx PATH /opt/fishtest $PATH
contains /opt/fishtest $PATH && echo path-list-ok
echo $PATH | string split -f1 :
alias gl 'echo log | string upper'
gl
abbr -a gst git status; abbr -q gst && echo abbr-ok
function on_greet --on-event greet; echo "greeted $argv"; end
emit greet alice
function on_dir --on-variable PWD; echo "moved"; end
cd /tmp
echo "function from_pipe; echo piped-def; end" | source
from_pipe
echo "one two" | read -l first rest; echo "$rest/$first"
type -q ls && echo type-q-ok
status --is-interactive; or echo not-interactive
echo (set_color brred --bold)X(set_color normal) | string escape
prompt_pwd /usr/local/share/doc
string match -q -- '-*' -v && echo dashdash-ok
if status is-login; echo login; else; echo not-login; end
switch linux
    case Linux linux
        echo switch-ok
end
set -l items a b c; echo (count $items) $items[-1]
